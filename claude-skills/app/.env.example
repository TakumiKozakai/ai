# PostgreSQL（app/docker/.env と同じ値にする）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# バックエンドの待ち受けポート
SERVER_PORT=8080
# JWT の署名鍵。32文字以上のランダムな文字列（例: openssl rand -hex 32 の出力）
JWT_SECRET=
# https で配信するときだけ true（Cookie に Secure 属性を付ける）
COOKIE_SECURE=false
# ビルド済みフロントエンドの場所（app/backend からの相対パス）
STATIC_DIR=../frontend/dist
