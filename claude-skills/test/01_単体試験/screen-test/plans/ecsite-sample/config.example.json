        "expectedBefore": {
          "pw_products": [
            { "name": "PW_サンプル商品 検索確認用", "price": 1234, "stock_quantity": 10, "is_published": true }
          ]
        },
        "unchanged": true
      },
      "appLog": {
        "path": "/REPLACE_WITH_ABSOLUTE_PATH/claude-skills/app/logs/app.log",
        "contains": ["/api/products?", "keyword=PW_"]
      },
      "s3": { "notApplicable": "ECサイトはS3を使用しない" },
      "ec2": { "notApplicable": "ローカル実施のためEC2で稼働していない。アプリログはappLogで確認する" }
