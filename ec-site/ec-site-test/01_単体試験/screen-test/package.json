{
  "name": "screen-evidence-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node src/runner.ts --config config.local.json",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:list": "playwright test --list",
    "typecheck": "tsc -p .",
    "install:browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^22.20.4",
    "typescript": "~5.9.2"
  }
}
